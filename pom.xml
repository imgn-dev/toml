<?xml version="1.0" encoding="UTF-8"?>
<!-- child.project.url.inherit.append.path: the attribute is not inherited from
     be.imgn.parent:parent once <url> is redefined here, so it is repeated. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.imgn.parent</groupId>
    <artifactId>parent</artifactId>
    <version>2026-10-17</version>
    <relativePath/>
  </parent>

  <groupId>be.imgn.toml</groupId>
  <artifactId>toml-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>TOML parent</name>
  <description>Build configuration shared by the TOML modules.</description>
  <!-- The parent's url and scm do not append child paths, so without these
       they would point at imgn-parent. -->
  <url>https://github.com/imgn-dev/toml</url>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/imgn-dev/toml.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/imgn-dev/toml.git</developerConnection>
    <url>https://github.com/imgn-dev/toml</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>toml</module>
    <module>toml-processor</module>
  </modules>

  <properties>
    <!-- The baseline the library runs on. The parent wires this into the
         compiler's and javadoc's release and into requireJavaVersion. -->
    <java.release>21</java.release>

    <gaia.version>0.1.2-SNAPSHOT</gaia.version>
  </properties>

</project>
